# --- LLM provider: openai | anthropic | ollama ---
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible API (DeepSeek, Moonshot, ...). For DeepSeek:
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_API_KEY=<your key from platform.deepseek.com>
#   OPENAI_MODEL=deepseek-chat        # or deepseek-reasoner
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings: chroma-default (zero-config local) | openai | ollama ---
EMBEDDING_PROVIDER=chroma-default
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Agent behavior ---
RETRIEVAL_TOP_K=6
CRITIC_ENABLED=true
ROUNDTABLE_MAX_PERSONAS=3
